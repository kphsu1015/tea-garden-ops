# 正式模式請填入Supabase專案資訊。程式會優先讀取PUBLISHABLE_KEY，沒有的話才退回ANON_KEY。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 尚未連接Supabase時可使用示範模式
NEXT_PUBLIC_DEMO_MODE=true

# 進貨單AI辨識（只放伺服器環境，請勿加NEXT_PUBLIC_前綴）
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

RECEIPT_RETENTION_DAYS=90

# 注意：本專案不使用SUPABASE_SERVICE_ROLE_KEY。所有Supabase讀寫都透過登入者自己的session並受RLS約束，
# 分類管理等需要權限的操作一律以Supabase Auth登入身分執行，請勿在伺服器環境加入service role金鑰。
